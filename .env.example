# Google Drive Service Account Credentials
# Obtain these from Google Cloud Console when creating a service account

# The email address of your Google Drive service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# The private key from the service account JSON file (include the full key with newlines)
# Replace literal newlines with \n when setting this value
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Drive Configuration
# The ID of the parent folder "Photography Site Albums/" shared with the service account
# Find this in the folder's URL: https://drive.google.com/drive/folders/{FOLDER_ID}
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here
