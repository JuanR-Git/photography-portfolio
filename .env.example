# Google Drive Service Account Credentials
# Obtain these from Google Cloud Console when creating a service account

# The email address of your Google Drive service account
# Found in the service account JSON file as "client_email"
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# The private key from the service account JSON file
# Copy the entire key including "-----BEGIN PRIVATE KEY-----" and "-----END PRIVATE KEY-----"
# The \n characters should be preserved as-is
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Drive Parent Folder ID
# The ID of the "Photography Site Albums" folder shared with the service account
# Find this in the folder's URL: https://drive.google.com/drive/folders/{FOLDER_ID}
GOOGLE_DRIVE_PARENT_FOLDER_ID=your_folder_id_here

# Optional: Base URL for the site (used for absolute URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
